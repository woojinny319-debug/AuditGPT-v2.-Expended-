# 환경 변수 및 API 키 (절대 커밋 금지)
.env
*.env
RAG_Project_Open AI API_KEY.txt

# ChromaDB 벡터 저장소 (재생성 가능; 실제 DB는 ASCII 경로 ~/rag_chroma_data 에 있음)
chroma_db/
chroma_db_v2/

# 임베딩/BM25 백업 (대용량, 재생성 가능): dart_data.pkl(174MB), dart_bm25.pkl(37MB)
*.pkl

# 가상환경 (재생성 가능: python -m venv venv)
venv/

# Python 캐시
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# PDF 원본 파일 (용량 큰 이진 파일 / 저작권). 공유하려면 이 줄을 주석 처리
*.pdf

# 로그
*.log
streamlit.log
.streamlit/*
# 다크 테마는 파트너와 공유
!.streamlit/config.toml

# 임시 텍스트 (단, requirements.txt 는 공유)
*.txt
!requirements.txt

# 일회성 진단/테스트 스크립트 (run_benchmark.py / finalize_db.py / rebuild_dart_index.py 는 공유)
check_*.py
dump_*.py
test_*.py
# _e2e.py, _shot.py 등 스크린샷/디버깅용 임시 스크립트
_*.py
adr_test_result.md
# 개인 논문 스터디용 문서 (GitHub 공유 제외)
프로젝트 기술스택 개요 (논문 스터디용).md

